<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationTitle>DAMiner</ApplicationTitle>
    <ApplicationId>com.buildwithraymond.daminer</ApplicationId>
    <AssemblyName>DAMiner</AssemblyName>
    <RootNamespace>DAGoldManager.Desktop</RootNamespace>
    <Product>DAMiner</Product>
    <Description>Dark Ages gold automation</Description>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <ApplicationIcon>Resources/AppIcon/appicon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.0" />
    <ProjectReference Include="../DAGoldManager.UI/DAGoldManager.UI.csproj" />
    <MauiIcon Include="Resources/AppIcon/appicon.png" />
    <Content Include="Resources/AppIcon/appicon.ico" Link="DAMiner.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#11161c" BaseSize="128,128" />
    <Content Include="../../content/**" Link="content/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../vendor/DAQuester/LICENSE" Link="licenses/DAQuester-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../vendor/DAQuester/THIRD_PARTY_NOTICES.md" Link="licenses/DAQuester-THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../vendor/DAQuester/DAQuester.DarkAges/Vendor/ARBITER-LICENSE.txt" Link="licenses/ARBITER-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="licenses/DAMiner-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../THIRD_PARTY_NOTICES.md" Link="licenses/DAMiner-THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/Velopack-LICENSE.txt" Link="licenses/Velopack-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
