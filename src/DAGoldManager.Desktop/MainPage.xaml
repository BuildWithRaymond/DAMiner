<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DAGoldManager.Desktop"
             xmlns:components="clr-namespace:DAGoldManager.UI;assembly=DAGoldManager.UI"
             x:Class="DAGoldManager.Desktop.MainPage">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Dashboard}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
